<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

  <!-- Plugin Metadata -->
  <PropertyGroup>
    <PluginId>SpeecilTweaks</PluginId>
    <PluginName>SpeecilTweaks</PluginName>
    <Authors>zjavierf</Authors>
    <Version>0.1.2</Version>
    <GameVersion>1.40.8</GameVersion>
    <Description>General Tweaks for Beat Saber</Description>
    <!--<PluginIcon></PluginIcon>-->
    <!--<ProjectSource>https://github.com/zjavierf/SpeecilTweaks-Reloaded</ProjectSource>-->
    <!--<ProjectHome>https://github.com/zjavierf/SpeecilTweaks-Reloaded</ProjectHome>-->
    <!--<DonateUrl></DonateUrl>-->
  </PropertyGroup>

  <!-- Plugin Dependencies -->
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0"/>
  </ItemGroup>
  
  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
  
</Project>
